"use client";

import { useState, useEffect } from "react";
import { motion } from "framer-motion";
import { Clock, Shield, MessageCircle, X, Send, Paperclip } from "lucide-react";

interface ChatMessage {
  text: string;
  isAdmin: boolean;
  timestamp: Date;
}

export default function PendingApprovalPage() {
  const [isChatOpen, setIsChatOpen] = useState(false);
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [newMessage, setNewMessage] = useState("");
  const [file, setFile] = useState<File | null>(null);

  useEffect(() => {
    const saved = localStorage.getItem("steeze_pending_messages");
    if (saved) {
      const parsed = JSON.parse(saved);
      const withDates = parsed.map((m: ChatMessage) => ({ ...m, timestamp: new Date(m.timestamp) }));
      setMessages(withDates);
    } else {
      setMessages([
        {
          text: "Welcome to STEEZE! Your application has been submitted. Admin will review your documents within 24-48 hours. You'll receive a notification once approved. Meanwhile, feel free to ask any questions here.",
          isAdmin: true,
          timestamp: new Date(),
        },
      ]);
    }
  }, []);

  useEffect(() => { localStorage.setItem("steeze_pending_messages", JSON.stringify(messages)); }, [messages]);

  const sendMessage = () => {
    if (newMessage.trim() || file) {
      const userMessage: ChatMessage = { text: newMessage || "(file attachment)", isAdmin: false, timestamp: new Date() };
      setMessages((prev) => [...prev, userMessage]);
      setNewMessage("");
      setFile(null);
      setTimeout(() => {
        setMessages((prev) => [...prev, { text: "Thank you for your message. Admin will respond shortly.", isAdmin: true, timestamp: new Date() }]);
      }, 2000);
    }
  };

  return (
    <div className="min-h-screen bg-black pt-24 pb-12 px-4">
      <div className="container mx-auto max-w-2xl">
        <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} className="glass-card p-8 text-center">
          <div className="w-20 h-20 mx-auto mb-6 rounded-full bg-gold/20 flex items-center justify-center">
            <Clock className="text-gold" size={40} />
          </div>
          <h1 className="text-2xl md:text-3xl font-bold text-gold mb-3">Application Under Review</h1>
          <p className="text-white/70 mb-6">Your creator application has been submitted successfully. Admin will review your documents and selfie.</p>
          <div className="bg-white/5 rounded-lg p-4 mb-6 text-left">
            <div className="flex items-center gap-2 mb-3">
              <Shield size={18} className="text-gold" />
              <span className="text-white font-semibold">What happens next?</span>
            </div>
            <ul className="space-y-2 text-white/60 text-sm">
              <li>1. Admin reviews your ID and selfie (24-48 hours)</li>
              <li>2. You'll receive an email and in-app notification</li>
              <li>3. Once approved, you can access your creator dashboard</li>
              <li>4. Start uploading content and building your website profile</li>
            </ul>
          </div>
          <div className="bg-gold/10 border border-gold/30 rounded-lg p-4">
            <p className="text-white/70 text-sm">
              <span className="text-gold font-semibold">Why verification?</span> STEEZE is a platform for real creators and real fans. No fake accounts. No bots. Every account is verified.
            </p>
          </div>
        </motion.div>
      </div>

      <button onClick={() => setIsChatOpen(true)} className="fixed bottom-6 right-6 z-50 bg-gradient-to-r from-gold to-gold-dark text-black p-4 rounded-full shadow-lg hover:shadow-xl transition-all animate-bounce">
        <MessageCircle size={24} />
      </button>

      {isChatOpen && (
        <div className="fixed bottom-24 right-6 z-50 w-96 glass-card border border-white/20 shadow-2xl">
          <div className="flex justify-between items-center p-4 border-b border-white/10">
            <h3 className="text-gold font-semibold">Admin Support</h3>
            <button onClick={() => setIsChatOpen(false)} className="text-white/50 hover:text-white"><X size={18} /></button>
          </div>
          <div className="h-80 overflow-y-auto p-4 space-y-3">
            {messages.map((msg, idx) => (
              <div key={idx} className={`flex ${msg.isAdmin ? "justify-start" : "justify-end"}`}>
                <div className={`max-w-[80%] p-3 rounded-lg ${msg.isAdmin ? "bg-white/10 text-white" : "bg-gold text-black"}`}>
                  <p className="text-sm">{msg.text}</p>
                  <span className="text-xs opacity-50 mt-1 block">{msg.timestamp.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}</span>
                </div>
              </div>
            ))}
          </div>
          <div className="p-4 border-t border-white/10 flex gap-2">
            <label className="cursor-pointer text-white/50 hover:text-gold"><Paperclip size={18} /><input type="file" className="hidden" onChange={(e) => setFile(e.target.files?.[0] || null)} /></label>
            <input type="text" value={newMessage} onChange={(e) => setNewMessage(e.target.value)} onKeyDown={(e) => e.key === "Enter" && sendMessage()} placeholder="Type your message..." className="flex-1 px-3 py-2 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/30 focus:outline-none focus:border-gold" />
            <button onClick={sendMessage} className="p-2 bg-gold rounded-lg text-black"><Send size={16} /></button>
          </div>
        </div>
      )}
    </div>
  );
}