  id          String    @id @default(uuid())
  type        String    // database, files, full
  status      String    @default("pending") // pending, running, completed, failed
  size        Int?
  location    String?
  startedAt   DateTime
  completedAt DateTime?
  createdBy   String
}

model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("pending") // pending, processing, completed, failed
  dataTypes   Json      @default("[]")
  fileUrl     String?
  fileSize    Int?
  expiresAt   DateTime?
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  downloadedAt DateTime?
}

model DistributionCredential {
  id         String    @id @default(uuid())
  channel    String    // distrokid, youtube, spotify, apple_music, tidal
  apiKey     String
  apiSecret  String?
  status     String    @default("active")
  lastTested DateTime?
  lastError  String?
  expiresAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model DistributionJob {
  id           String    @id @default(uuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id])
  channel      String
  status       String    @default("pending") // pending, processing, completed, failed, retry
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  errorMessage String?
  priority     Int       @default(0)
  scheduledAt  DateTime?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
}

model WebhookEndpoint {
  id              String    @id @default(uuid())
  channel         String    @unique
  url             String
  secret          String
  events          Json
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Broadcast {
  id            String    @id @default(uuid())
  title         String
  message       String
  recipientType String    // all, creators, vibes, zls_artists, independent_creators
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
}

model SystemSettings {
  id                 Int      @id @default(1)
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?
  updatedBy          String?
  updatedAt          DateTime @default(now())
}

// Age Verification & Parental Controls
model ParentalConsent {
  id              String    @id @default(uuid())
  childId         String    @unique
  child           User      @relation("ParentalConsentChild", fields: [childId], references: [id])
  parentId        String
  parent          User      @relation("ParentalConsentParent", fields: [parentId], references: [id])
  consentCode     String?
  consentGivenAt  DateTime  @default(now())
  consentMethod   String    @default("email") // email, id_scan, credit_card
  expiresAt       DateTime
  status          String    @default("active") // pending, active, revoked, expired
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Consent records for GDPR/POPIA compliance
model ConsentRecord {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  consentType   String    // email_marketing, sms_marketing, push_notifications, analytics
  status        String    // granted, withdrawn
  grantedAt     DateTime?
  withdrawnAt   DateTime?
  ipAddress     String?
  userAgent     String?
  source        String?   // signup, settings, checkout
  createdAt     DateTime  @default(now())
}

// Double opt-in email verification
model EmailVerification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  email         String
  code          String
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

// Opt-out records for CAN-SPAM/POPIA compliance
model OptOutRecord {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  email         String
  consentType   String    // email_marketing, sms_marketing, push_notifications, all
  token         String    @unique
  status        String    @default("active") // active, opted_out
  optedOutAt    DateTime  @default(now())
  source        String?   // email_link, settings_page, api
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
}

// Email tracking for analytics
model EmailLog {
  id              String    @id @default(uuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  email           String
  type            String    // welcome, marketing, notification, verification
  subject         String
  status          String    // sent, delivered, opened, clicked, bounced
  openedAt        DateTime?
  clickedAt       DateTime?
  unsubscribedAt  DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
}

// CDN Health Monitoring
model CDNHealthLog {
  id               String    @id @default(uuid())
  primaryHealthy   Boolean
  secondaryHealthy Boolean
  tertiaryHealthy  Boolean?
  activeCDN        String
  timestamp        DateTime  @default(now())
}

// ========================
// ANALYTICS MODELS
// ========================

// Platform-wide daily analytics aggregation
model DailyAnalytics {
  id              String   @id @default(uuid())
  date            DateTime @unique
  totalUsers      Int      @default(0)
  totalCreators   Int      @default(0)
  totalVibes      Int      @default(0)
  totalPosts      Int      @default(0)
  totalViews      Int      @default(0)
  totalLikes      Int      @default(0)
  totalComments   Int      @default(0)
  totalReposts    Int      @default(0)
  totalSaves      Int      @default(0)
  totalRevenue    Float    @default(0)
  platformRevenue Float    @default(0)
  creatorPayouts  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Per-creator daily analytics
model CreatorAnalytics {
  id            String   @id @default(uuid())
  creatorId     String
  creator       User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date          DateTime
  views         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  reposts       Int      @default(0)
  saves         Int      @default(0)
  followersGain Int      @default(0)
  revenue       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([creatorId, date])
}

// Per-content analytics
model ContentAnalytics {
  id             String   @id @default(uuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  views          Int      @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  reposts        Int      @default(0)
  saves          Int      @default(0)
  avgWatchTime   Float?   // seconds (for videos)
  completionRate Float?   // 0-100
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([postId])
}

// ========================
// AUDIT: REVIEW & NOTIFICATION MODELS
// ========================

// AUDIT: Content pending review queue with priority and assignment
model ReviewQueue {
  id            String    @id @default(cuid())
  postId        String    @unique
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  priority      Int       @default(0)  // 0=normal, 1=high, 2=urgent
  assignedTo    String?   // Admin user ID (references User.id)
  status        String    @default("pending") // pending, in_review, approved, rejected
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([status])
  @@index([priority])
  @@index([submittedAt])
  @@index([assignedTo])
  @@index([status, priority])
}

// AUDIT: Complete audit trail for all review actions
model ReviewHistory {
  id            String    @id @default(cuid())
  postId        String
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action        String    // approved, rejected, flagged, reassigned, bulk_approved, bulk_rejected
  notes         String?
  previousStatus String?
  newStatus     String
  metadata      Json?     // Additional data (bulk count, reason codes, etc.)
  createdAt     DateTime  @default(now())

  @@index([postId])
  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@index([createdAt, action])
}

// AUDIT: Admin notifications for pending reviews and system events
model AdminNotification {
  id            String    @id @default(cuid())
  adminId       String
  admin         User      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type          String    @default("info") // info, warning, critical, review_needed
  title         String
  message       String
  link          String?
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([adminId])
  @@index([isRead])
  @@index([createdAt])
}

// GROUP W: VIBER saved posts (save/repost functionality)
model SavedPost {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId        String
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  // For playlists: VIBER can organize saved audio into playlists
  playlistId    String?

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([createdAt])
  @@index([playlistId])
}

// GROUP W: Direct purchase tracking for locked content
model DirectPurchase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId        String
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  amount        Int       // Amount paid in cents
  status        String    @default("pending") // pending, completed, failed, refunded
  paymentMethod String?   // payfast, card, etc.
  transactionId String?   // Payment gateway reference
  metadata      Json?     // Additional payment data
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, postId])  // Prevent duplicate purchases
  @@index([userId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
}

// ========================
// GROUP X: ADVERTISER MANAGEMENT
// ========================

// Advertiser account for ad campaigns
model Advertiser {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hashed with bcrypt
  companyName   String
  website       String?
  taxId         String?   // VAT / Tax registration number
  address       String?
  phone         String?
  status        String    @default("pending") // pending, approved, rejected, suspended
  approvedBy    String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       AdvertiserProfile?
  verification  AdvertiserVerification?
  campaigns     Campaign[]
  payments      AdPayment[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Advertiser profile (additional info)
model AdvertiserProfile {
  id            String    @id @default(cuid())
  advertiserId  String    @unique
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  logoUrl       String?
  description   String?
  industry      String?   // music, fashion, tech, etc.
  targetAudience Json?    // Age range, interests, locations
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Advertiser verification documents
model AdvertiserVerification {
  id            String    @id @default(cuid())
  advertiserId  String    @unique
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  documentType  String    // business_license, tax_certificate, id_document
  documentUrl   String
  status        String    @default("pending") // pending, verified, rejected
  verifiedBy    String?
  verifiedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Ad payment transactions
model AdPayment {
  id            String    @id @default(cuid())
  advertiserId  String
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amount        Int       // Amount in cents
  currency      String    @default("ZAR")
  status        String    @default("pending") // pending, completed, failed, refunded
  paymentMethod String?   // payfast, card, etc.
  transactionId String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

// Ad campaign
model Campaign {
  id            String    @id @default(cuid())
  advertiserId  String
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  
  // Campaign details
  name          String
  description   String?
  placement     String    // feed_standard, feed_premium, video_short, video_premium, explore, trending, homepage_hero
  cpm           Int       // CPM in cents (e.g., 400 = $4.00)
  budget        Int       // Total budget in cents
  spent         Int       @default(0) // Spent amount in cents
  remainingBudget Int    @default(0) // Calculated field
  
  // Targeting
  countries     Json?     // Array of country codes
  interests     Json?     // Array of interest categories
  ageRange      Json?     // { min: 18, max: 65 }
  
  // Media
  mediaUrl      String    // Ad creative URL
  mediaType     String    // image, video
  destinationUrl String   // Where user goes on click
  
  // Scheduling
  startDate     DateTime?
  endDate       DateTime?
  
  // Status
  status        String    @default("draft") // draft, pending_review, approved, active, paused, rejected, completed, suspended
  rejectionReason String?
  
  // Admin fields
  approvedBy    String?
  approvedAt    DateTime?
  reviewedBy    String?
  reviewedAt    DateTime?
  
  // Metrics
  impressions   Int       @default(0)
  clicks        Int       @default(0)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  payments      AdPayment[]
  impressions_log AdImpression[]
  clicks_log    AdClick[]

  @@index([advertiserId])
  @@index([status])
  @@index([placement])
  @@index([createdAt])
  @@index([startDate])
  @@index([endDate])
}

// Ad impression tracking
model AdImpression {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String?   // User who saw the ad (if logged in)
  sessionId     String    // For anonymous tracking
  ipAddress     String?
  userAgent     String?
  viewedAt      DateTime  @default(now())
  viewDuration  Int?      // Milliseconds viewed
  fullyVisible  Boolean   @default(false) // Was ad fully on screen for 1.5+ seconds?

  @@index([campaignId])
  @@index([userId])
  @@index([viewedAt])
}

// Ad click tracking
model AdClick {
  id            String    @id @default(cuid())
  campaignId    String
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String?
  sessionId     String
  ipAddress     String?
  userAgent     String?
  clickedAt     DateTime  @default(now())

  @@index([campaignId])
  @@index([userId])
  @@index([clickedAt])
}

// Unified ad application (advertiser + campaign together)
model AdApplication {
  id            String    @id @default(cuid())
  
  // Advertiser info
  companyName   String
  email         String
  password      String    // Hashed with bcrypt
  taxId         String?
  phone         String?
  address       String?
  website       String?
  
  // Campaign info
  campaignName      String
  campaignDescription String?
  placement         String
  cpm               Int       // CPM in cents
  budget            Int       // Total budget in cents
  mediaUrl          String
  mediaType         String    // image, video
  destinationUrl    String
  countries         Json?     // Array of country codes
  interests         Json?     // Array of interest categories
  ageRange          Json?     // { min: 18, max: 65 }
  startDate         DateTime?
  endDate           DateTime?
  
  // Status
  status            String    @default("pending") // pending, approved, rejected
  rejectionReason   String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  
  // References after approval
  advertiserId      String?
  campaignId        String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}


model CreatorWallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  balance        Float    @default(0)
  totalEarned    Float    @default(0)
  totalWithdrawn Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model FailedLoginAttempt {
  id          String   @id @default(uuid())
  email       String
  ip          String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  @@index([email])
  @@index([attemptedAt])
}

model AdminAlert {
  id         String    @id @default(uuid())
  type       String
  severity   String
  title      String
  message    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([isResolved])
  @@index([createdAt])
}

model Transaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId        String?
  wallet          CreatorWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  amount          Float
  type            String   // credit, debit, payout, refund
  status          String   @default("pending") // pending, completed, failed, cancelled
  reference       String?  // Paystack reference ID, withdrawal ID, order ID
  description     String?
  metadata        Json?    // Additional data (subscriptionId, postId, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}
